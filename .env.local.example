# Upstash Redis — the one real backend touchpoint (see 03-architecture.md).
# Get these from your Upstash Redis database dashboard (REST API section).
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
